# =============================================================
# 【码道】新声平台后端环境变量样例
# 复制为 .env 后按需修改；真实密钥禁止提交到仓库
# =============================================================

# 应用
APP_ENV=dev
SECRET_KEY=dev-secret-key-please-change-me-2026
TOKEN_EXPIRE_MINUTES=120

# 数据库
# 演示默认使用 SQLite（零配置），可用下面的 MySQL 连接串切换
DATABASE_URL=sqlite:///./xinsheng.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/xinsheng?charset=utf8mb4

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# 华为云大模型（OpenAI 兼容接口）
# 未配置 AI_ENABLED=true 时，平台使用本地模板兜底，保证演示可跑
AI_ENABLED=false
AI_BASE_URL=https://your-modelarts-endpoint/v1
AI_API_KEY=
AI_MODEL=pangu
AI_TIMEOUT=8

# 演示缓存回放：断网时读取本地缓存，保证 3 分钟 Demo 不中断
CACHE_REPLAY=true
CACHE_DIR=./app/static/cache

# 跨域（前后端分离时按实际前端地址配置）
CORS_ORIGINS=*